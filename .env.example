# Versioned fraud model artifact
FRAUD_MODEL_PATH=/app/models/fraud_ds1_xgb_v1/model.joblib
FRAUD_MODEL_METADATA_PATH=/app/models/fraud_ds1_xgb_v1/metadata.json

# Optional Neo4j graph enrichment
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Optional JSONL operational monitoring log
FRAUD_MONITORING_LOG=/app/runtime/scoring_events.jsonl
